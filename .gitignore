*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Coverage reports
coverage/
htmlcov/
*.coverage

# OS generated files
.DS_Store
Thumbs.db

# Package manager lock files (preserving existing)
package-lock.json
```